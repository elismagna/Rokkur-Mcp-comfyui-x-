# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me

# Folder on the host with source videos / reference images; mounted read-only at /media.
# Use /media/<file> as local_path when creating projects from Docker.
STUDIO_MEDIA_DIR=./media

# Services already running on the Windows host.
STUDIO_COMFYUI__URL=http://host.docker.internal:8188
STUDIO_OLLAMA__URL=http://host.docker.internal:11434
# Cloud rendering (optional, docs/cloud.md): a ComfyUI server you rent or run elsewhere.
# Each new video then picks This PC or Cloud. Keep the token here only, never in git.
# STUDIO_CLOUD__ENABLED=true
# STUDIO_CLOUD__URL=http://host.docker.internal:8189
# STUDIO_CLOUD__TOKEN=
# STUDIO_CLOUD__VRAM_GB=24
# STUDIO_CLOUD__PRICE_PER_HOUR_USD=0     # what the provider charges an hour, for the estimate
# STUDIO_COSTS__MAX_CLOUD_GPU_MINUTES=60
# RunPod start/stop (docs/cloud.md): the desktop icon then asks whether to start the pod,
# starts ComfyUI on it and opens the SSH tunnel; the studio stops it after 30 idle minutes.
# STUDIO_CLOUD__RUNPOD_API_KEY=          # RunPod > Settings > API Keys; keep it here only
# STUDIO_CLOUD__RUNPOD_POD_ID=           # the pod's id, shown on the pod in RunPod
# STUDIO_CLOUD__SSH_KEY=                 # empty: C:\Users\<you>\.ssh\id_ed25519

# ffmpeg_preview (no GPU, non-AI stand-in) or comfyui (real renders).
STUDIO_RENDER__RENDERER=comfyui
STUDIO_AGENTS__PROVIDER=ollama
STUDIO_STUDIO__AUTONOMY_LEVEL=2

# YouTube: put the Google OAuth "Desktop app" client JSON at ./secrets/youtube_client_secret.json
# (git-ignored), run `.\scripts\studio.ps1 youtube-auth`, then switch uploads on here.
# Uploads are private unless you ask otherwise; public needs STUDIO_YOUTUBE__ALLOW_PUBLIC=true too.
STUDIO_YOUTUBE__ENABLED=false
# Scheduled releases (private now, public at a set time) also need ALLOW_PUBLIC=true.
# STUDIO_YOUTUBE__TIMEZONE=Europe/Oslo
# STUDIO_YOUTUBE__RELEASE_TIMES=18:00
# STUDIO_YOUTUBE__DEFAULT_PLAYLIST_ID=PLxxxxxxxxxx
