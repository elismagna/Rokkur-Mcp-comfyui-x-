# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me

# Folder on the host with source videos / reference images; mounted read-only at /media.
# Use /media/<file> as local_path when creating projects from Docker.
STUDIO_MEDIA_DIR=./media

# Services already running on the Windows host.
STUDIO_COMFYUI__URL=http://host.docker.internal:8188
STUDIO_OLLAMA__URL=http://host.docker.internal:11434

# ffmpeg_preview (no GPU, non-AI stand-in) or comfyui (real renders).
STUDIO_RENDER__RENDERER=ffmpeg_preview
STUDIO_AGENTS__PROVIDER=ollama
STUDIO_STUDIO__AUTONOMY_LEVEL=2

# YouTube: put the Google OAuth "Desktop app" client JSON at ./secrets/youtube_client_secret.json
# (git-ignored), run `.\scripts\studio.ps1 youtube-auth`, then switch uploads on here.
# Uploads are private unless you ask otherwise; public needs STUDIO_YOUTUBE__ALLOW_PUBLIC=true too.
STUDIO_YOUTUBE__ENABLED=false
